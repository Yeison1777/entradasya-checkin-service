generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Checkin {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @unique @map("ticket_id") @db.Uuid
  ticketCode   String   @map("ticket_code") @db.VarChar(64)
  eventId      String   @map("event_id") @db.Uuid
  doorStaffId  String   @map("door_staff_id") @db.Uuid
  checkedInAt  DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(3)

  @@index([eventId, checkedInAt])
  @@index([doorStaffId])
  @@map("checkins")
}
